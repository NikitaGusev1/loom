{
  "name": "dag-executor",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "dag-executor": "./build/index.js",
    "loom-day-run": "./scripts/loom-supervisor.cjs",
    "loom-supervisor": "./scripts/loom-supervisor.cjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf build",
    "start": "node build/index.js",
    "test": "tsc && node --test \"build/**/*.test.js\"",
    "lintTypes": "tsc --noEmit",
    "lint": "prettier --check src",
    "format": "prettier --write src",
    "smoke:loom": "scripts/loom-supervisor-smoke.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.8.4",
    "typescript": "^5.8.0"
  }
}
